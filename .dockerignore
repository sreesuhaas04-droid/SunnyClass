# Keep the Docker build context small — only ship what the app needs.
.git
.gitignore
razorpay
stitch_smartclass_ai_platform
preview
logs
node_modules
.DS_Store
*.md
*.db
.env
.env.*
!.env.example
docker-compose.yml
render.yaml
vercel.json
shots.py
shot_sunny.py
run.sh
backend/__pycache__
backend/**/__pycache__
backend/.env
backend/smartclass.db
backend/sunnyclass.db
backend/tests
backend/storage/recordings/*
!backend/storage/recordings/.gitkeep
