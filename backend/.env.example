# ---- Core ----------------------------------------------------------------
ENV=development
DEBUG=true
SECRET_KEY=replace-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- Database ------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:smartclass@localhost:5432/smartclass
# SQLite alternative (no server needed):
# DATABASE_URL=sqlite+aiosqlite:///./smartclass.db

# ---- CORS ----------------------------------------------------------------
CORS_ORIGINS=*

# ---- SUNNY AI ------------------------------------------------------------
# provider: groq | gemini | openai | anthropic | none
# Leave as "none" to run entirely free on the built-in knowledge base.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=

# ---- Face recognition ----------------------------------------------------
FACE_MATCH_THRESHOLD=0.52
FACE_ATTENDANCE_MIN_CONFIDENCE=0.60
VERIFY_INTERVAL_SECONDS=45

# ---- Attendance policy ---------------------------------------------------
LATE_AFTER_MINUTES=10
PRESENT_MIN_PRESENCE_RATIO=0.60

# ---- Proctoring ----------------------------------------------------------
MAX_VIOLATIONS_BEFORE_FLAG=3
VIOLATION_ENGAGEMENT_PENALTY=8

# ---- WebRTC --------------------------------------------------------------
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# A TURN server is only needed for students behind symmetric NAT / strict firewalls.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Point at any OpenAI-compatible server (Ollama, vLLM, LM Studio, LiteLLM,
# OpenRouter). Leave empty to use the provider's own endpoint.
# LLM_PROVIDER=custom
# LLM_BASE_URL=http://localhost:11434/v1
