# ---- Core ----------------------------------------------------------------
APP_NAME=SunnyClass AI
ENV=development
DEBUG=true
SECRET_KEY=replace-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- Database ------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:sunnyclass@localhost:5432/sunnyclass
# SQLite alternative (no server needed):
# DATABASE_URL=sqlite+aiosqlite:///./sunnyclass.db
DB_ECHO=false

# ---- CORS ----------------------------------------------------------------
# Use "*" for open access or a comma-separated list of allowed origins.
CORS_ORIGINS=*

# ---- SUNNY AI ------------------------------------------------------------
# provider: groq | gemini | openai | anthropic | none
# Leave as "none" to run entirely free on the built-in knowledge base.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=

# Point at any OpenAI-compatible server (Ollama, vLLM, LM Studio, LiteLLM,
# OpenRouter). Leave empty to use the provider's own endpoint.
LLM_BASE_URL=

# Request timeout (seconds) and max tokens per LLM response.
LLM_TIMEOUT=20.0
LLM_MAX_TOKENS=700

# ---- Face recognition ----------------------------------------------------
# Euclidean distance threshold for face-api.js 128-d descriptors.
# Lower = stricter (fewer false accepts). 0.52 is a safe default.
FACE_MATCH_THRESHOLD=0.52
FACE_ATTENDANCE_MIN_CONFIDENCE=0.60
FACE_DESCRIPTOR_DIM=128
FACE_MIN_SAMPLES=1
# How often the classroom client re-verifies the student's face (seconds).
VERIFY_INTERVAL_SECONDS=45

# ---- Attendance policy ---------------------------------------------------
# Students arriving more than this many minutes after session start are "late".
LATE_AFTER_MINUTES=10
# A student must be detected for >= this fraction of the session to keep "present".
PRESENT_MIN_PRESENCE_RATIO=0.60

# ---- Proctoring ----------------------------------------------------------
MAX_VIOLATIONS_BEFORE_FLAG=3
VIOLATION_ENGAGEMENT_PENALTY=8

# ---- Media / storage -----------------------------------------------------
# Directory (relative to the backend working directory) for uploaded recordings.
STORAGE_DIR=storage
# Maximum size of a single recording upload in megabytes.
MAX_RECORDING_MB=512

# ---- WebRTC --------------------------------------------------------------
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# A TURN server is only needed for students behind symmetric NAT / strict firewalls.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
